# raw game dumps (regenerated by tools/extract_game.py; only the build tools need them)
data/raw/

# test copies of saves
.tmp/

# build output
mods/*/bin/
mods/*/obj/
__pycache__/
*.pyc

# local Claude Code settings (launch.json is shared)
.claude/*
!.claude/launch.json

# Nexus release archives (built from bin/)
mods/*/nexus/*.zip
