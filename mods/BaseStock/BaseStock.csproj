<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <AssemblyName>BaseStock</AssemblyName>
    <RootNamespace>BaseStock</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <CheckEolTargetFramework>false</CheckEolTargetFramework>
    <!-- Game folder with MelonLoader installed (run the game once so Il2CppAssemblies get generated) -->
    <GameDir Condition="'$(GameDir)' == ''">C:\Program Files (x86)\Steam\steamapps\common\Nova Lands</GameDir>
    <MLDir>$(GameDir)\MelonLoader</MLDir>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="$(MLDir)\net6\MelonLoader.dll" Private="false" />
    <Reference Include="$(MLDir)\net6\Il2CppInterop.Runtime.dll" Private="false" />
    <Reference Include="$(MLDir)\Il2CppAssemblies\*.dll" Private="false" />
  </ItemGroup>

  <!-- dotnet build -c Release -p:Deploy=true  → copies the mod into <game>\Mods -->
  <Target Name="DeployToGame" AfterTargets="Build" Condition="'$(Deploy)' == 'true'">
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(GameDir)\Mods" />
  </Target>

</Project>
